[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="npc"
3d_physics/layer_5="projectile"
3d_physics/layer_6="interact"
3d_physics/layer_7="target_pick"
3d_physics/layer_8="occluder"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.03, 0.01, 0.07, 1)
