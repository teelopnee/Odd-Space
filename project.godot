; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ODD-SPACE"
config/description="Sci-Fi HD-2D Action-RPG: retro-futurist dark satire, causality-driven emergent narrative."
config/version="0.7.0"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.03, 0.01, 0.07, 1)
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
DataDB="*res://src/autoload/data_db.gd"
Game="*res://src/autoload/game_state.gd"
Factions="*res://src/autoload/faction_manager.gd"
Causality="*res://src/autoload/causality_graph.gd"
Origin="*res://src/autoload/origin_system.gd"
Crew="*res://src/autoload/crew_manager.gd"
FlawPerk="*res://src/autoload/flaw_perk_system.gd"
Encounters="*res://src/autoload/encounter_director.gd"
Saga="*res://src/autoload/saga.gd"
Stories="*res://src/autoload/stories.gd"
Interactions="*res://src/autoload/interactions.gd"
ShipAI="*res://src/autoload/ship_ai.gd"
Audio="*res://src/autoload/audio_manager.gd"
Router="*res://src/autoload/scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://assets/ui/holo_theme.tres"

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0
}

[input]

